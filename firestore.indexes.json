{
  "//": "Composite indexes required by the app's list queries. Deploy with: firebase deploy --only firestore:indexes (or add them via the console links Firestore prints in the error).",
  "indexes": [
    {
      "collectionGroup": "products",
      "queryScope": "COLLECTION",
